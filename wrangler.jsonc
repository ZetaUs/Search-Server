{
  "name": "search-server",
  "main": "./worker.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "SEARCH_API": "https://api.duckduckgo.com"
  },
  "routes": [
    {
      "pattern": "search-server.zztxorg.dpdns.org",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
